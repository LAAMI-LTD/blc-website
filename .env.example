# Resend (https://resend.com) API key used server-side to send contact
# form enquiries and newsletter signups. NEVER commit the real value or
# expose it to the client — it's only read inside app/api/*/route.ts
# (server-side routes).
RESEND_API_KEY=  re_Eo6WWR37_BSugXX919PRGXzjZA3VCVCdB
# The mailbox that should receive contact form submissions.
# Defaults to the value in config/institution.ts if unset.
# The organization's current address is bbtikenya@gmail.com; they intend
# to switch to info@bbti.co.ke once the bbti.co.ke domain is live.
CONTACT_EMAIL=bbtikenya@gmail.com

# Resend Audience ID for footer newsletter signups. Create an Audience at
# https://resend.com/audiences and paste its ID here. Without this (and
# RESEND_API_KEY above), the newsletter form correctly returns a 503
# rather than silently pretending to subscribe people.
RESEND_AUDIENCE_ID=

# The "From" address used when sending contact form emails via Resend.
# Requires bbti.co.ke to be added and verified as a sending domain in
# Resend first (see README "Resend Production Setup"). Until then, leave
# unset — the contact route falls back to Resend's shared testing address.
# Example once verified: RESEND_FROM_EMAIL="BBTI Website <info@bbti.co.ke>"
RESEND_FROM_EMAIL=
